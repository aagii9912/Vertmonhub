# Vertmon Hub — орчны хувьсагчийн жишээ (.env.local болгож хуулна)
# Заавал = production-д тохируулах ёстой. Сонголтот = тохируулаагүй бол тухайн feature идэвхгүй.

# ── Supabase (ЗААВАЛ) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude dashboard туслах (ЗААВАЛ) ─────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# ── Gemini AI (lead form-ийн угтах хариу, өрсөлдөгчийн шинжилгээ) ────────────────────────────
GEMINI_API_KEY=

# ── App (ЗААВАЛ) ──────────────────────────────────
NEXT_PUBLIC_APP_URL=

# ── Facebook / Instagram (DM → Inbox webhook + marketing) ─
# Per-shop Page/IG token-ууд DB (shops хүснэгт)-д хадгалагдана; доорхи нь app-level
# тохиргоо болон single-tenant fallback токен.
# Хуучин апп (2026-10-13-нд Meta-д хаагдсан: «API access blocked»). META_PAGE_APP=legacy үед л Page/DM/Lead Ads-д.
# Webhook, data deletion-ий гарын үсгийг энэ нууцаар ч шалгасаар байна (шилжилтийн үед).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# «Vertmon Hub» апп: Meta Ads (ads_read, зардал) болон анхдагчаар Page, Instagram, DM, Lead Ads (lib/facebook/page-app.ts).
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_LOGIN_CONFIG_ID=
# «Vertmon Hub» аппын Page/Instagram-ийн Facebook Login for Business тохиргооны ID (pages_show_list,
# pages_read_engagement, read_insights, pages_manage_metadata, pages_messaging, leads_retrieval, …).
META_PAGE_LOGIN_CONFIG_ID=
# legacy = хуучин FACEBOOK_APP_*-ийг Page/DM/Lead Ads-д ашиглах (буцаах). Хоосон = «Vertmon Hub».
META_PAGE_APP=
# Business Manager-ийн System User токен (хугацаагүй, ads_read; Vertmon Hub app-д үүсгэсэн).
# Тохируулсан бол бүх төслийн Meta Ads синк хэрэглэгчийн 60 хоногийн токеноос түрүүлж үүнийг ашиглана.
# Зөвхөн сервер — Vercel-д Sensitive, чат/код/баримтад хэзээ ч бичихгүй (docs/features/META-INSIGHTS-API-2026-10-05.md).
# Non-expiring System User token for the Marketing API; server-only secret, preferred over per-shop user tokens.
META_ADS_SYSTEM_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
# Хуучин аппын FB Login for Business (META_PAGE_APP=legacy үед) — ХОЁУЛАА тохируулсан үед л идэвхжинэ.
FACEBOOK_LOGIN_USE_CONFIG=
FACEBOOK_LOGIN_CONFIG_ID=

# ── Токен шифрлэлт (FB/IG token-ыг encrypt хийхэд) ─
# 32 байт (base64 эсвэл hex) түлхүүр. Тохируулаагүй бол токен plaintext хадгална.
TOKEN_ENCRYPTION_KEY=

# ── Cron хамгаалалт (ЗААВАЛ production-д) ──────────
# Тохируулаагүй бол /api/cron/* нээлттэй болно.
CRON_SECRET=

# ── Web Push (VAPID) ──────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@vertmon.mn

# ── Marketing tracking (сонголтот) ────────────────
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
META_CAPI_ACCESS_TOKEN=
# Сонголтот: META_CAPI_ACCESS_TOKEN-ий app-ийн нууц түлхүүр (appsecret_proof). Events Manager-ийн
# dataset токен ихэвчлэн FACEBOOK_APP_SECRET-ийн app-д хамаардаггүй — зөвхөн ижил app гэдгийг
# мэдэж байвал тохируулна, буруу нууцтай бол Meta event-ийг буцаана.
META_CAPI_APP_SECRET=

# ── Cloudflare Turnstile (public lead form captcha) ─
TURNSTILE_SECRET_KEY=

# ── Гадаад landing page-ээс лид хүлээн авах (сонголтот) ─
# /api/leads-д зөвшөөрөх нэмэлт origin-ууд (таслалаар тусгаарлана).
# Ж: https://mandala-garden.mn,https://www.mandala-garden.mn
LEAD_ALLOWED_ORIGINS=
# Угталтын имэйл доторх "Танилцуулга үзэх" товчны холбоос (default: NEXT_PUBLIC_APP_URL)
LEAD_WELCOME_SITE_URL=
# Нэг төслийн public form-ийн баталгаатай projects.id UUID
LEAD_PROJECT_ID=
# Олон сайт: exact origin -> projects.id UUID JSON object
LEAD_PROJECT_ORIGINS=
# Сонголтот: дээрх төслийн shop_id-тай заавал таарна
LEAD_SHOP_ID=

# ── Elysium сайт → /api/integrations/elysium/leads (сервер хооронд) ─
# Elysium Vercel-ийн VERTMONHUB_LEADS_SECRET-тэй ижил нууц түлхүүр
ELYSIUM_LEAD_SYNC_SECRET=
# projects.id; лидийн shop_id-г уг төслөөс авна
ELYSIUM_LEAD_PROJECT_ID=
# Тулгалтын татан авалт (/api/cron/elysium-leads-sync, Админ → Холболтууд): дамжуулалтаар
# ирээгүй хүсэлтийг Elysium Supabase-ийн event_leads-ээс нөхнө. Зөвхөн сервер (NEXT_PUBLIC биш).
# Elysium-ийн Supabase URL
ELYSIUM_SUPABASE_URL=
# Elysium-ийн service key, эсвэл зөвхөн event_leads-ийг SELECT хийх эрхтэй role-ийн түлхүүр (зөвлөмж)
ELYSIUM_SUPABASE_SERVICE_KEY=
# Зөвхөн scripts/backfill-elysium-landing-pages.ts: landing page-ийн хаягийн суурь (анхдагч https://elysium.mn).
# Скрипт Elysium-ийн `events`-ийг уншина — event_leads-ээр хязгаарласан түлхүүр хүрэлцэхгүй.
ELYSIUM_SITE_URL=

# ── Rate limit (сонголтот) — байхгүй бол Supabase check_rate_limit RPC ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── HubSpot sync (сонголтот) ──────────────────────
HUBSPOT_ACCESS_TOKEN=

# ── Имэйл (Resend, сонголтот) ─────────────────────
# Домэйн verify хийсний дараа EMAIL_FROM-д брэнд илгээгчээ тохируулна.
# Ж: "Mandala Garden <info@mandala-garden.mn>"
RESEND_API_KEY=
EMAIL_FROM=
# Өдрийн/долоо хоногийн тайлан хүлээн авах имэйл (захирал)
DIGEST_EMAIL=

# ── Sentry (сонголтот, observability) ─────────────
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload (байхгүй бол upload алгасна)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
