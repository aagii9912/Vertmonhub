# Vertmon Hub — орчны хувьсагчийн жишээ (.env.local болгож хуулна)
# Заавал = production-д тохируулах ёстой. Сонголтот = тохируулаагүй бол тухайн feature идэвхгүй.

# ── Supabase (ЗААВАЛ) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini AI (ЗААВАЛ) ────────────────────────────
GEMINI_API_KEY=

# ── App (ЗААВАЛ) ──────────────────────────────────
NEXT_PUBLIC_APP_URL=

# ── Facebook / Instagram (DM webhook + marketing) ─
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ── Токен шифрлэлт (FB/IG token-ыг encrypt хийхэд) ─
# 32 байт (base64 эсвэл hex) түлхүүр. Тохируулаагүй бол токен plaintext хадгална.
TOKEN_ENCRYPTION_KEY=

# ── Cron хамгаалалт (ЗААВАЛ production-д) ──────────
# Тохируулаагүй бол /api/cron/* нээлттэй болно.
CRON_SECRET=

# ── Admin bootstrap (нэг удаагийн super_admin) ────
# 16+ тэмдэгт. Ашигласны дараа устгана.
ADMIN_SETUP_SECRET=

# ── Web Push (VAPID) ──────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@vertmon.mn

# ── Marketing tracking (сонголтот) ────────────────
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
META_CAPI_ACCESS_TOKEN=

# ── Cloudflare Turnstile (public lead form captcha) ─
TURNSTILE_SECRET_KEY=

# ── Sentry (сонголтот, observability) ─────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Session JWT (middleware cookie шалгалт) ───────
SESSION_JWT_SECRET=
