{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "sin1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/overdue-check",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/data-cleanup",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/ads-insights-sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/social-insights-sync",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron/process-webhook-jobs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/task-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/channel-expiry",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/cron/ai-digest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/director-digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/morning-leads",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/customer-followups",
      "schedule": "45 0 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/anomaly-watch",
      "schedule": "30 7 * * *"
    }
  ]
}
